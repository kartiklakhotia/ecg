$pipeline $depth 7 $fullrate $module [fp16_add_for_ecg]
$in ( f1 : $uint<16>   f2 : $uint<16>  )
$out ( result : $uint<16>  )
$is
{
  $call faddsub16 (f1 f2 ZERO_1 ) (result ) 
}

